# ==========================================================
# FIND MY CAR — fichiers à NE PAS publier sur GitHub
# ==========================================================

# Dépendances Node.js (réinstallées avec "npm install")
node_modules/

# Résultats et captures des tests (régénérés à chaque lancement)
tests/captures/
coverage/

# Données personnelles / secrets : ne JAMAIS les publier
.env
.env.*
*.pem
*.key
secrets/

# Exports de base de données réelle (la base de l'application vit dans le
# navigateur ; un export pourrait contenir des noms et e-mails saisis)
*.sqlite
*.sqlite3
*.db
exports/

# Réglages personnels de VS Code (on garde seulement les recommandations)
.vscode/*
!.vscode/extensions.json

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Journaux
*.log
npm-debug.log*

# Archives
*.zip
